# Servidor
PORT=3333
HOST=0.0.0.0
CORS_ORIGINS=http://192.168.1.100:5173,http://localhost:5173

# APIs externas
# Sem a chave, a Leitura de IA do Abastecimento do Full responde 501 e o resto
# do relatório funciona igual. A busca na web exige cota de grounding no projeto
# do Google AI Studio; sem ela a leitura sai marcada como "sem busca na web".
GEMINI_API_KEY=sua_chave_aqui
# Opcional. Id de modelo sai de linha sem aviso; trocar aqui não pede deploy.
GEMINI_MODEL=gemini-3.6-flash

# Banco de dados (Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analise_de_valores

# Autenticação (obrigatório em produção)
BETTER_AUTH_SECRET=uma_chave_secreta_longa_e_aleatoria_aqui